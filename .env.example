# Copy to .env and fill in. Nothing here is required to run the site itself —
# the front end degrades to mailto: links when the backend is absent.

PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787     # where THIS server is reachable
SITE_ORIGIN=http://127.0.0.1:5173       # where the site is served from (CORS)
DATA_DIR=./data

# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_… first)
STRIPE_SECRET_KEY=
# Create at https://dashboard.stripe.com/webhooks pointing to
# $PUBLIC_ORIGIN/api/stripe/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Google sign-in for the admin page — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: $PUBLIC_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: `openssl rand -base64 48`
SESSION_SECRET=
# Who may open the admin page. Comma separated.
ADMIN_EMAILS=michael@koiwrangler.com,eddie@koiwrangler.com

# Where new bookings and paid orders get announced. Any JSON webhook works:
# Slack/Discord incoming webhook, or an ntfy.sh topic URL for phone pings.
NOTIFY_WEBHOOK_URL=
